@model List<EcommerceApp.Models.CartItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tu carrito";
    var hayProblemaDeStock = Model.Any(i => i.Product == null || i.Product.Stock <= 0 || i.Quantity > i.Product.Stock);
    var puedeConfirmar = Model.Any() && !hayProblemaDeStock;
}
<link rel="stylesheet" href="~/css/carrito.css" asp-append-version="true" />

<div class="container-fluid cart-page">
    <section class="cart-hero">
        <h1 class="cart-title">Tu carrito 🏔</h1>
        <p class="cart-sub">Productos seleccionados para tu aventura.</p>
    </section>

    <div class="cart-layout">
        <div class="cart-layout__main">
            @if (!Model.Any())
            {
                <div class="cart-empty-state">
                    <h3 class="cart-empty-state__title">Tu carrito está vacío</h3>
                    <p>Explora nuestra tienda y agrega productos de senderismo.</p>
                    <a asp-controller="Products" asp-action="Index" class="cart-btn-primary cart-empty-state__btn">Ver tienda</a>
                </div>
            }
            else
            {
                <a asp-controller="Products" asp-action="Index" class="cart-back">&larr; Seguir comprando</a>
                <div class="cart-list">
                    @foreach (var item in Model)
                    {
                        var p = item.Product;
                        var precioVigente = p?.PromotionalPrice ?? p?.Price ?? item.UnitPrice;
                        var sinStock = p == null || p.Stock <= 0;
                        var superaStock = p != null && !sinStock && item.Quantity > p.Stock;
                        <div class="cart-item">
                            <img src="@(p?.ImageUrl ?? "/images/default-product.svg")" class="cart-item__img" alt="" />
                            <div class="cart-item__info">
                                <h4 class="cart-item__name">@(p?.Name ?? "Producto no disponible")</h4>
                                <div class="cart-item__meta">@p?.Category</div>
                                <div class="cart-item__price">@PriceFormatter.Format(precioVigente) c/u &middot; Subtotal: @PriceFormatter.Format(precioVigente * item.Quantity)</div>
                                @if (sinStock)
                                {
                                    <div class="cart-item__warning cart-item__warning--error">Sin stock disponible. Quítalo del carrito para continuar.</div>
                                }
                                else if (superaStock)
                                {
                                    <div class="cart-item__warning">Solo quedan @p!.Stock unidades. Ajusta la cantidad para continuar.</div>
                                }
                            </div>
                            <div class="cart-item__actions">
                                <form asp-action="Update" method="post" class="cart-inline-form">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="direction" value="dec" />
                                    <button type="submit" class="cart-qty-btn" disabled="@(item.Quantity <= 1)">−</button>
                                </form>
                                <span class="cart-item__qty">@item.Quantity</span>
                                <form asp-action="Update" method="post" class="cart-inline-form">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="direction" value="inc" />
                                    <button type="submit" class="cart-qty-btn" disabled="@(sinStock || (p != null && item.Quantity >= p.Stock))">+</button>
                                </form>
                                <form asp-action="Remove" method="post" class="cart-inline-form cart-item__remove-form">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger cart-item__remove" aria-label="Quitar del carrito">✕</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="cart-layout__aside">
            <div class="cart-summary">
                <h3 class="cart-summary__title">Resumen</h3>
                <div class="cart-summary__line">
                    <span>Subtotal</span>
                    <strong>@PriceFormatter.Format((decimal)ViewBag.Total)</strong>
                </div>
                <hr class="cart-summary__divider" />
                <div class="cart-summary__total">
                    <span>Total estimado</span>
                    <span>@PriceFormatter.Format((decimal)ViewBag.Total)</span>
                </div>
                <form asp-controller="Orders" asp-action="Checkout" method="post">
                    <button type="submit" class="btn-admin btn-admin-primary cart-summary__btn" disabled="@(!puedeConfirmar)">Confirmar pedido</button>
                </form>
                @if (hayProblemaDeStock)
                {
                    <div class="cart-summary__note">Corrige los productos sin stock suficiente para continuar.</div>
                }
            </div>
        </div>
    </div>
</div>
