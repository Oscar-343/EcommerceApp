@model EcommerceApp.Models.ServiciosViewModel
@using EcommerceApp.Models
@{
    ViewData["Title"] = "Rutas - Experiencias de Aventura";
    ViewData["FullBleed"] = true; // El hero ocupa toda la pantalla, detrás del navbar transparente

    // Rutas para el hero rotativo: las que tienen foto (ya vienen "destacadas primero").
    var heroRoutes = Model.Services.Where(r => !string.IsNullOrEmpty(r.ImageUrl)).Take(4).ToList();

    // Ícono de cada categoría de ruta (Font Awesome). Las que no estén aquí usan fa-route.
    string IconoCategoria(string? categoria) => categoria switch
    {
        "Senderismo" => "fa-person-hiking",
        "Trekking" => "fa-shoe-prints",
        "Trekking con camping" => "fa-campground",
        "Alta montaña" => "fa-mountain",
        "Caminatas de naturaleza" => "fa-tree",
        "Aventura extrema" => "fa-bolt",
        "Volcanes y montañas" => "fa-volcano",
        "Escalada" => "fa-mountain-sun",
        _ => "fa-route"
    };

    // Duración elegida, como un solo valor para el <select> ("min-max").
    var duracionActual = (Model.MinDuration, Model.MaxDuration) switch
    {
        (null, 3) => "-3",
        (3, 6) => "3-6",
        (6, 10) => "6-10",
        (10, null) => "10-",
        _ => ""
    };

    var hayFiltros = !string.IsNullOrEmpty(Model.ActiveRegion) || !string.IsNullOrEmpty(Model.ActiveDifficulty)
        || !string.IsNullOrEmpty(Model.ActiveCategory) || Model.MinDuration.HasValue || Model.MaxDuration.HasValue
        || !string.IsNullOrEmpty(Model.SearchTerm);

    // Parámetros actuales, para armar los enlaces de categoría y de páginas sin perder los demás filtros.
    Dictionary<string, string> Ruta(string? category, int page = 1)
    {
        var r = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(category)) r["category"] = category;
        if (!string.IsNullOrEmpty(Model.ActiveRegion)) r["region"] = Model.ActiveRegion;
        if (!string.IsNullOrEmpty(Model.ActiveDifficulty)) r["difficulty"] = Model.ActiveDifficulty;
        if (Model.MinDuration.HasValue) r["minDuration"] = Model.MinDuration.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (Model.MaxDuration.HasValue) r["maxDuration"] = Model.MaxDuration.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (!string.IsNullOrEmpty(Model.SearchTerm)) r["search"] = Model.SearchTerm;
        if (!string.IsNullOrEmpty(Model.OrderBy)) r["orderBy"] = Model.OrderBy;
        if (page > 1) r["page"] = page.ToString();
        return r;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
    @if (Model.MapRoutes.Any())
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
}

<div class="cuenta-page">
    <!-- === HERO ROTATIVO DE RUTAS === -->
    <section class="rutas-hero" id="rutasHero">
        @if (heroRoutes.Any())
        {
            <div class="rutas-hero__slides">
                @for (int i = 0; i < heroRoutes.Count; i++)
                {
                    <div class="rutas-hero__slide @(i == 0 ? "active" : "")" data-index="@i" style="background-image: url('@heroRoutes[i].ImageUrl')"></div>
                }
                <div class="rutas-hero__overlay"></div>
            </div>

            <div class="rutas-hero__content">
                @for (int i = 0; i < heroRoutes.Count; i++)
                {
                    var route = heroRoutes[i];
                    <div class="rutas-hero__info @(i == 0 ? "active" : "")" data-index="@i">
                        <p class="rutas-hero__kicker">@(route.Region ?? route.Location ?? "Bolivia")</p>
                        <h1 class="rutas-hero__title">@route.Name</h1>
                        <p class="rutas-hero__subtitle">@(route.ShortDescription ?? route.Location)</p>
                        <a asp-action="Details" asp-route-id="@route.Id" class="rutas-hero__cta">DESCUBRIR RUTA <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                }
            </div>

            <div class="rutas-hero__stack" id="rutasHeroStack">
                @for (int i = 0; i < heroRoutes.Count; i++)
                {
                    var route = heroRoutes[i];
                    <button type="button" class="rutas-hero__stack-item @(i == 0 ? "active" : "")" data-index="@i" style="background-image: url('@route.ImageUrl')">
                        <span class="rutas-hero__stack-location">@(route.Location ?? route.Region)</span>
                        <span class="rutas-hero__stack-name">@route.Name</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="rutas-hero__slides">
                <div class="rutas-hero__slide active" style="background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&h=900&fit=crop')"></div>
                <div class="rutas-hero__overlay"></div>
            </div>
            <div class="rutas-hero__content">
                <div class="rutas-hero__info active">
                    <h1 class="rutas-hero__title">EL CAMINO TE ESTÁ ESPERANDO</h1>
                    <p class="rutas-hero__subtitle">Explora rutas de senderismo, conecta con la naturaleza y descubre nuevos caminos.</p>
                    <a href="#rutas" class="rutas-hero__cta">EXPLORAR RUTAS <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
        }
    </section>

    <div class="cuenta-wrap">
        <!-- === BARRA DE FILTROS === -->
        <section class="rutas-filtros" id="rutas">
            <nav class="rutas-filtros__chips" aria-label="Categorías">
                <a asp-action="Index" asp-all-route-data="Ruta(null)"
                   class="rutas-chip @(string.IsNullOrEmpty(Model.ActiveCategory) ? "rutas-chip--activa" : "")">
                    <i class="fa-solid fa-mountain-sun" aria-hidden="true"></i> Todas
                </a>
                @foreach (var cat in Model.AvailableCategories)
                {
                    <a asp-action="Index" asp-all-route-data="Ruta(cat)"
                       class="rutas-chip @(Model.ActiveCategory == cat ? "rutas-chip--activa" : "")">
                        <i class="fa-solid @IconoCategoria(cat)" aria-hidden="true"></i> @cat
                    </a>
                }
            </nav>

            <form method="get" asp-action="Index" class="rutas-filtros__selects" id="rutasFiltrosForm">
                @if (!string.IsNullOrEmpty(Model.ActiveCategory))
                {
                    <input type="hidden" name="category" value="@Model.ActiveCategory" />
                }
                @if (!string.IsNullOrEmpty(Model.SearchTerm))
                {
                    <input type="hidden" name="search" value="@Model.SearchTerm" />
                }
                <input type="hidden" name="minDuration" value="@Model.MinDuration" id="minDuration" />
                <input type="hidden" name="maxDuration" value="@Model.MaxDuration" id="maxDuration" />

                <label class="visually-hidden" for="fRegion">Ubicación</label>
                <select id="fRegion" name="region" class="rutas-select">
                    <option value="">Ubicación</option>
                    @foreach (var region in Model.AvailableRegions)
                    {
                        <option value="@region" selected="@(Model.ActiveRegion == region)">@region</option>
                    }
                </select>

                <label class="visually-hidden" for="fDificultad">Dificultad</label>
                <select id="fDificultad" name="difficulty" class="rutas-select">
                    <option value="">Dificultad</option>
                    @foreach (var diff in RouteDifficulty.Labels)
                    {
                        <option value="@diff.Key" selected="@(Model.ActiveDifficulty == diff.Key)">@diff.Value</option>
                    }
                </select>

                <label class="visually-hidden" for="fDuracion">Duración</label>
                <select id="fDuracion" class="rutas-select" data-duracion>
                    <option value="" selected="@(duracionActual == "")">Duración</option>
                    <option value="-3" selected="@(duracionActual == "-3")">Hasta 3 h</option>
                    <option value="3-6" selected="@(duracionActual == "3-6")">3 a 6 h</option>
                    <option value="6-10" selected="@(duracionActual == "6-10")">6 a 10 h</option>
                    <option value="10-" selected="@(duracionActual == "10-")">Más de 10 h</option>
                </select>

                <label class="visually-hidden" for="fOrden">Ordenar por</label>
                <select id="fOrden" name="orderBy" class="rutas-select">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.OrderBy))">Ordenar por</option>
                    <option value="price-asc" selected="@(Model.OrderBy == "price-asc")">Menor precio</option>
                    <option value="price-desc" selected="@(Model.OrderBy == "price-desc")">Mayor precio</option>
                    <option value="duration" selected="@(Model.OrderBy == "duration")">Más cortas</option>
                    <option value="distance" selected="@(Model.OrderBy == "distance")">Menor distancia</option>
                </select>

                <noscript><button type="submit" class="cuenta-btn cuenta-btn--sm cuenta-btn--auto">Filtrar</button></noscript>
            </form>
        </section>

        <div class="rutas-resultado">
            <span>@Model.TotalFiltered @(Model.TotalFiltered == 1 ? "ruta encontrada" : "rutas encontradas")</span>
            @if (hayFiltros)
            {
                <a asp-action="Index" class="cuenta-link-sutil"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Quitar filtros</a>
            }
        </div>

        <!-- === TARJETAS DE RUTAS === -->
        @if (Model.Services.Any())
        {
            <div class="rutas-grid">
                @foreach (var route in Model.Services)
                {
                    var diffKey = route.Difficulty ?? "";
                    var diffLabel = RouteDifficulty.Labels.TryGetValue(diffKey, out var etiqueta) ? etiqueta : null;
                    var esFavorita = Model.FavoriteServiceIds.Contains(route.Id);
                    var duracion = !string.IsNullOrEmpty(route.Duration) ? route.Duration
                        : route.DurationHours.HasValue ? $"{route.DurationHours:0.#} h" : null;

                    <article class="ruta-card">
                        <div class="ruta-card__media">
                            <a asp-action="Details" asp-route-id="@route.Id" tabindex="-1" aria-hidden="true">
                                <img src="@(route.ImageUrl ?? route.SecondaryImageUrl ?? "/images/default-product.svg")" alt="" loading="lazy" />
                            </a>
                            @if (diffLabel != null)
                            {
                                <span class="ruta-card__dificultad ruta-card__dificultad--@diffKey">@diffLabel</span>
                            }
                            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="ruta-card__fav-form" data-fav-form>
                                <input type="hidden" name="type" value="Service" />
                                <input type="hidden" name="itemId" value="@route.Id" />
                                <button type="submit" class="ruta-card__fav @(esFavorita ? "is-active" : "")"
                                        aria-label="@(esFavorita ? "Quitar de favoritos" : "Guardar en favoritos")" aria-pressed="@(esFavorita ? "true" : "false")">
                                    <i class="@(esFavorita ? "fa-solid" : "fa-regular") fa-heart" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>

                        <div class="ruta-card__body">
                            @if (!string.IsNullOrEmpty(route.Location ?? route.Region))
                            {
                                <p class="ruta-card__lugar"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @(route.Location ?? route.Region)</p>
                            }
                            <h2 class="ruta-card__titulo">
                                <a asp-action="Details" asp-route-id="@route.Id">@route.Name</a>
                            </h2>
                            @if (!string.IsNullOrEmpty(route.ShortDescription))
                            {
                                <p class="ruta-card__desc">@route.ShortDescription</p>
                            }

                            <div class="ruta-card__datos">
                                <div>
                                    <strong><i class="fa-solid fa-route" aria-hidden="true"></i> @(route.DistanceKm.HasValue ? $"{route.DistanceKm:0.#} km" : "—")</strong>
                                    <span>Distancia</span>
                                </div>
                                <div>
                                    <strong><i class="fa-regular fa-clock" aria-hidden="true"></i> @(duracion ?? "—")</strong>
                                    <span>Duración aprox.</span>
                                </div>
                                <div>
                                    <strong><i class="fa-solid fa-user-group" aria-hidden="true"></i> @route.MaxGroupSize</strong>
                                    <span>Grupo máx.</span>
                                </div>
                            </div>

                            <div class="ruta-card__pie">
                                <a asp-action="Details" asp-route-id="@route.Id" class="ruta-card__ver">
                                    Ver ruta <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                </a>
                                <div class="ruta-card__precio">
                                    <small>Desde</small>
                                    @PriceFormatter.Format(route.Price)
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="cuenta-panel">
                <div class="cuenta-vacio">
                    <div class="cuenta-vacio__icono"><i class="fa-solid fa-compass" aria-hidden="true"></i></div>
                    <div class="cuenta-vacio__titulo">No encontramos rutas con esos filtros</div>
                    <p>Prueba con otra categoría o dificultad. El camino correcto sigue ahí afuera.</p>
                    <a asp-action="Index" class="cuenta-btn cuenta-btn--auto">Ver todas las rutas</a>
                </div>
            </div>
        }

        <!-- === PIE: frase + paginación === -->
        <div class="rutas-pie">
            <p class="rutas-pie__lema">
                <i class="fa-solid fa-mountain" aria-hidden="true"></i>
                Montañas <span>/</span> Bosques <span>/</span> Grandes historias
            </p>

            @if (Model.TotalPages > 1)
            {
                <nav class="rutas-paginas" aria-label="Páginas de rutas">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index" asp-all-route-data="Ruta(Model.ActiveCategory, Model.Page - 1)" class="rutas-paginas__flecha" aria-label="Página anterior">
                            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                        </a>
                    }
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <a asp-action="Index" asp-all-route-data="Ruta(Model.ActiveCategory, p)"
                           class="rutas-paginas__num @(p == Model.Page ? "is-active" : "")"
                           aria-current="@(p == Model.Page ? "page" : null)">@p</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-all-route-data="Ruta(Model.ActiveCategory, Model.Page + 1)" class="rutas-paginas__flecha" aria-label="Página siguiente">
                            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                </nav>
            }
        </div>

        <!-- === MAPA (todas las rutas filtradas) === -->
        @if (Model.MapRoutes.Any())
        {
            <section class="cuenta-panel rutas-mapa">
                <div class="cuenta-panel__head">
                    <h2 class="cuenta-panel__title">
                        <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
                        Rutas en el mapa
                    </h2>
                </div>
                <div id="rutasMap" class="rutas-map"
                     data-routes='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapRoutes.Select(r => new { id = r.Id, name = r.Name, location = r.Location, lat = r.Lat, lng = r.Lng })))'></div>
            </section>
        }
    </div>
</div>

@section Scripts {
    @if (Model.MapRoutes.Any())
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="~/js/rutas-map.js" asp-append-version="true"></script>
    }
    <script src="~/js/servicios.js" asp-append-version="true"></script>
}
