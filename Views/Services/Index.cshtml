@model EcommerceApp.Models.ServiciosViewModel
@using EcommerceApp.Models
@{
    ViewData["Title"] = "Rutas - Experiencias de Aventura";
    ViewData["FullBleed"] = true; // El hero ocupa toda la pantalla, detrás del navbar transparente
}

@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Montserrat:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        body {
            background-color: #0B100E;
            color: #F1F3F1;
            font-family: 'Inter', sans-serif;
        }
    </style>
}

    <div class="servicios-page">
        @{
            // Rutas para el hero rotativo: las que tienen foto, ya vienen ordenadas
            // "destacadas primero" desde el controlador.
            var heroRoutes = Model.Services.Where(s => !string.IsNullOrEmpty(s.ImageUrl)).Take(5).ToList();
        }

        <!-- === HERO ROTATIVO DE RUTAS === -->
        <section class="rutas-hero" id="rutasHero">
            @if (heroRoutes.Any())
            {
                <div class="rutas-hero__slides">
                    @for (int i = 0; i < heroRoutes.Count; i++)
                    {
                        <div class="rutas-hero__slide @(i == 0 ? "active" : "")" data-index="@i" style="background-image: url('@heroRoutes[i].ImageUrl')"></div>
                    }
                    <div class="rutas-hero__overlay"></div>
                </div>

                <div class="rutas-hero__content">
                    @for (int i = 0; i < heroRoutes.Count; i++)
                    {
                        var route = heroRoutes[i];
                        <div class="rutas-hero__info @(i == 0 ? "active" : "")" data-index="@i">
                            <p class="rutas-hero__kicker">@(route.Region ?? route.Location ?? "Bolivia")</p>
                            <h1 class="rutas-hero__title">@route.Name</h1>
                            <p class="rutas-hero__subtitle">@(route.ShortDescription ?? route.Location)</p>
                            <a asp-action="Details" asp-route-id="@route.Id" class="rutas-hero__cta">DESCUBRIR RUTA <i class="fas fa-arrow-right"></i></a>
                        </div>
                    }
                </div>

                <div class="rutas-hero__stack" id="rutasHeroStack">
                    @for (int i = 0; i < heroRoutes.Count; i++)
                    {
                        var route = heroRoutes[i];
                        <button type="button" class="rutas-hero__stack-item @(i == 0 ? "active" : "")" data-index="@i" style="background-image: url('@route.ImageUrl')">
                            <span class="rutas-hero__stack-location">@(route.Location ?? route.Region)</span>
                            <span class="rutas-hero__stack-name">@route.Name</span>
                        </button>
                    }
                </div>

                <div class="rutas-hero__controls">
                    <button type="button" id="rutasHeroPrev" aria-label="Ruta anterior"><i class="fas fa-chevron-left"></i></button>
                    <button type="button" id="rutasHeroPlay" aria-label="Pausar rotación"><i class="fas fa-pause"></i></button>
                    <button type="button" id="rutasHeroNext" aria-label="Ruta siguiente"><i class="fas fa-chevron-right"></i></button>
                    <span class="rutas-hero__counter"><span id="rutasHeroCounter">01</span> / @heroRoutes.Count.ToString("00")</span>
                </div>
            }
            else
            {
                <div class="rutas-hero__slide active" style="background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&h=900&fit=crop')"></div>
                <div class="rutas-hero__overlay"></div>
                <div class="rutas-hero__content">
                    <div class="rutas-hero__info active">
                        <h1 class="rutas-hero__title">EL CAMINO TE ESTÁ ESPERANDO</h1>
                        <p class="rutas-hero__subtitle">Explora rutas de senderismo, conecta con la naturaleza y descubre nuevos caminos.</p>
                        <a href="#rutas" class="rutas-hero__cta">EXPLORAR RUTAS <i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            }
        </section>

        <!-- Barra de estadísticas, debajo del hero -->
        <section class="rutas-stats-bar">
            <div class="servicios-container rutas-stats-bar__grid">
                <div class="rutas-stats-bar__item"><span>+@Model.TotalRoutes</span><small>Rutas</small></div>
                <div class="rutas-stats-bar__item"><span>@Model.TotalDifficulties</span><small>Niveles</small></div>
                <div class="rutas-stats-bar__item"><span>@Model.TotalWithGuide</span><small>Con guía</small></div>
            </div>
        </section>

        <!-- === MAPA DE RUTAS (funcional, tonos oscuros) === -->
        @{ var mapRoutes = Model.Services.Where(s => s.StartLatitude.HasValue && s.StartLongitude.HasValue).ToList(); }
        @if (mapRoutes.Any())
        {
            <section class="rutas-map-section">
                <div class="servicios-container">
                    <div class="servicios-section-header">
                        <h2 class="servicios-section-title">RUTAS EN EL MAPA</h2>
                    </div>
                    <div id="rutasMap" class="rutas-map" data-routes='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(mapRoutes.Select(r => new { id = r.Id, name = r.Name, location = r.Location, lat = r.StartLatitude, lng = r.StartLongitude })))'></div>
                </div>
            </section>
        }

        <!-- EXPLORADOR / FILTROS -->
        <section class="servicios-filters-section" id="rutas">
            <div class="servicios-container">
                <div class="servicios-section-header">
                    <h2 class="servicios-section-title">ENCUENTRA TU RUTA</h2>
                </div>

                <div class="servicios-filters">
                    <div class="servicios-filter-group">
                        <h3 class="servicios-filter-label">Ubicación</h3>
                        <div class="servicios-filter-options">
                            <a asp-action="Index" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(string.IsNullOrEmpty(Model.ActiveRegion) ? "servicios-filter-option--active" : "")">Todas</a>
                            @foreach (var region in Model.AvailableRegions)
                            {
                                <a asp-action="Index" asp-route-region="@region" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                                   class="servicios-filter-option @(Model.ActiveRegion == region ? "servicios-filter-option--active" : "")">@region</a>
                            }
                        </div>
                    </div>

                    <div class="servicios-filter-group">
                        <h3 class="servicios-filter-label">Dificultad</h3>
                        <div class="servicios-filter-options">
                            <a asp-action="Index" asp-route-region="@Model.ActiveRegion" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(string.IsNullOrEmpty(Model.ActiveDifficulty) ? "servicios-filter-option--active" : "")">Todas</a>
                            @foreach (var diff in RouteDifficulty.Labels)
                            {
                                <a asp-action="Index" asp-route-difficulty="@diff.Key" asp-route-region="@Model.ActiveRegion" asp-route-category="@Model.ActiveCategory"
                                   class="servicios-filter-option @(Model.ActiveDifficulty == diff.Key ? "servicios-filter-option--active" : "")">@diff.Value</a>
                            }
                        </div>
                    </div>

                                        <div class="servicios-filter-group">
                        <h3 class="servicios-filter-label">Categoría</h3>
                        <div class="servicios-filter-options">
                            <a asp-action="Index" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty"
                               class="servicios-filter-option @(string.IsNullOrEmpty(Model.ActiveCategory) ? "servicios-filter-option--active" : "")">Todas</a>
                            @foreach (var cat in Model.AvailableCategories)
                            {
                                <a asp-action="Index" asp-route-category="@cat" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty"
                                   class="servicios-filter-option @(Model.ActiveCategory == cat ? "servicios-filter-option--active" : "")">@cat</a>
                            }
                        </div>
                    </div>

                    <div class="servicios-filter-group">
                        <h3 class="servicios-filter-label">Duración</h3>
                        <div class="servicios-filter-options">
                            <a asp-action="Index" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(!Model.MinDuration.HasValue && !Model.MaxDuration.HasValue ? "servicios-filter-option--active" : "")">Todas</a>
                            <a asp-action="Index" asp-route-maxduration="3" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(Model.MaxDuration == 3 && !Model.MinDuration.HasValue ? "servicios-filter-option--active" : "")">Hasta 3 horas</a>
                            <a asp-action="Index" asp-route-minduration="3" asp-route-maxduration="6" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(Model.MinDuration == 3 && Model.MaxDuration == 6 ? "servicios-filter-option--active" : "")">3-6 horas</a>
                            <a asp-action="Index" asp-route-minduration="6" asp-route-maxduration="10" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(Model.MinDuration == 6 && Model.MaxDuration == 10 ? "servicios-filter-option--active" : "")">6-10 horas</a>
                            <a asp-action="Index" asp-route-minduration="10" asp-route-region="@Model.ActiveRegion" asp-route-difficulty="@Model.ActiveDifficulty" asp-route-category="@Model.ActiveCategory"
                               class="servicios-filter-option @(Model.MinDuration == 10 && !Model.MaxDuration.HasValue ? "servicios-filter-option--active" : "")">Más de 10 horas</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- LISTADO EDITORIAL -->
        <section class="servicios-discover">
            <div class="servicios-container">
                <div class="servicios-routes-editorial">
                    @if (Model.Services.Any())
                    {
                        bool alt = false;
                        foreach (var route in Model.Services)
                        {
                            var diffKey = route.Difficulty ?? "";
                            var diffLabel = RouteDifficulty.Labels.ContainsKey(diffKey) ? RouteDifficulty.Labels[diffKey] : "";
                            var diffEmoji = diffKey switch
                            {
                                RouteDifficulty.Easy => "🟢",
                                RouteDifficulty.Moderate => "🟡",
                                RouteDifficulty.Difficult => "🔴",
                                RouteDifficulty.Extreme => "⚫",
                                _ => ""
                            };

                            <div class="servicios-route-block @(alt ? "servicios-route-block--alt" : "")">
                                <div class="servicios-route-block__image">
                                    <img src="@(route.SecondaryImageUrl ?? route.ImageUrl ?? "/images/default-product.svg")" alt="@route.Name">
                                    <div class="servicios-route-block__overlay"></div>
                                </div>
                                <div class="servicios-route-block__content">
                                    <div class="servicios-route-block__meta">
                                        <span class="servicios-route-block__location">@route.Location</span>
                                        <span class="servicios-route-block__category">@route.Category</span>
                                    </div>
                                    <h3 class="servicios-route-block__title">@route.Name</h3>
                                    <p class="servicios-route-block__description">@route.ShortDescription</p>

                                    <div class="servicios-route-block__info">
                                        <span class="servicios-route-block__info-item">@diffEmoji @diffLabel</span>
                                        @if (!string.IsNullOrEmpty(route.Duration))
                                        {
                                            <span class="servicios-route-block__info-item">⏱️ @route.Duration</span>
                                        }
                                        @if (route.DistanceKm.HasValue)
                                        {
                                            <span class="servicios-route-block__info-item">📍 @route.DistanceKm km</span>
                                        }
                                    </div>
                                    <p class="servicios-route-block__price">Desde @PriceFormatter.Format(route.Price) / persona</p>
                                    <div class="servicios-route-block__actions">
                                        <a asp-controller="Services" asp-action="Details" asp-route-id="@route.Id" class="servicios-route-block__cta">DESCUBRIR RUTA →</a>
                                        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="servicios-route-block__fav-form">
                                            <input type="hidden" name="type" value="Service" />
                                            <input type="hidden" name="itemId" value="@route.Id" />
                                            <button type="submit" class="servicios-route-block__fav" aria-label="Agregar a favoritos"><i class="fas fa-heart"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            alt = !alt;
                        }
                    }
                    else
                    {
                        <div class="servicios-no-routes">No se encontraron rutas con los filtros seleccionados.</div>
                    }
                </div>
            </div>
        </section>
    </div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/servicios.js" asp-append-version="true"></script>
}