@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = Model.Name + " - Equipamiento Outdoor";

    var imagenPrincipal = Model.ImageUrl ?? "/images/default-product.svg";
    var imagenes = new List<string> { imagenPrincipal };
    if (!string.IsNullOrWhiteSpace(Model.SecondaryImageUrl)) imagenes.Add(Model.SecondaryImageUrl.Trim());
    if (!string.IsNullOrWhiteSpace(Model.GalleryImages))
        imagenes.AddRange(Model.GalleryImages.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    var enOferta = Model.PromotionalPrice.HasValue && Model.PromotionalPrice < Model.Price;
    var descuento = enOferta ? Math.Round((1 - (Model.PromotionalPrice!.Value / Model.Price)) * 100) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/productos-detalle.css" asp-append-version="true" />
}

<div class="cuenta-page">
    <div class="cuenta-wrap pdet">
        <!-- Migas de pan -->
        <nav class="pdet__migas" aria-label="Ruta de navegación">
            <a asp-controller="Products" asp-action="Index">Productos</a>
            @if (!string.IsNullOrEmpty(Model.Category))
            {
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <a asp-controller="Products" asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a>
            }
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            <span>@Model.Name</span>
        </nav>

        <div class="pdet__grid">
            <!-- === GALERÍA === -->
            <div class="pdet-galeria">
                <div class="pdet-galeria__main">
                    <img id="mainImage" src="@imagenPrincipal" alt="@Model.Name" />
                    @if (enOferta)
                    {
                        <span class="pdet-galeria__sello">-@(descuento)%</span>
                    }
                </div>

                @if (imagenes.Count > 1)
                {
                    <div class="pdet-galeria__thumbs">
                        @for (var i = 0; i < imagenes.Count; i++)
                        {
                            <button type="button" class="pdet-galeria__thumb @(i == 0 ? "active" : "")"
                                    onclick="cambiarImagen('@imagenes[i]', this)" aria-label="Ver imagen @(i + 1)">
                                <img src="@imagenes[i]" alt="" loading="lazy" />
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- === INFORMACIÓN === -->
            <div class="cuenta-panel pdet-info">
                @if (Model.Marca != null)
                {
                    <p class="cuenta-hero__eyebrow">@Model.Marca.Nombre</p>
                }

                <h1 class="pdet-info__titulo">@Model.Name</h1>

                <div class="pdet-info__chips">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="pdet-chip">@Model.Category</span>
                    }
                    @if (Model.IsNew)
                    {
                        <span class="cuenta-tag">Nuevo</span>
                    }
                    @if (Model.IsBestSeller)
                    {
                        <span class="cuenta-tag cuenta-tag--pendiente">Más vendido</span>
                    }
                </div>

                <div class="pdet-info__precio">
                    <span class="pdet-info__precio-actual">@PriceFormatter.Format(Model.PromotionalPrice ?? Model.Price)</span>
                    @if (enOferta)
                    {
                        <s class="pdet-info__precio-antes">@PriceFormatter.Format(Model.Price)</s>
                        <span class="cuenta-tag cuenta-tag--cancelado">Ahorras @(descuento)%</span>
                    }
                </div>

                <p class="pdet-info__desc">@Model.Description</p>

                <div class="pdet-info__stock @(Model.Stock > Model.StockMinimo ? "" : Model.Stock > 0 ? "pdet-info__stock--bajo" : "pdet-info__stock--agotado")">
                    @if (Model.Stock > Model.StockMinimo)
                    {
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i> <span>En stock · @Model.Stock disponibles</span>
                    }
                    else if (Model.Stock > 0)
                    {
                        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> <span>Últimas @Model.Stock unidades</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i> <span>Sin stock por ahora</span>
                    }
                </div>

                <!-- Acciones: cantidad + agregar + favorito en una sola fila -->
                <div class="pdet-info__acciones">
                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="pdet-info__carrito">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="cuenta-qty pdet-qty">
                                <button type="button" class="cuenta-qty__btn" onclick="cambiarCantidad(-1)" aria-label="Quitar una unidad">−</button>
                                <input type="number" id="cantidad" name="quantity" class="pdet-qty__input" value="1" min="1" max="@Model.Stock" aria-label="Cantidad" />
                                <button type="button" class="cuenta-qty__btn" onclick="cambiarCantidad(1)" aria-label="Agregar una unidad">+</button>
                            </div>
                            <button type="submit" class="cuenta-btn">
                                <i class="fa-solid fa-cart-plus" aria-hidden="true"></i> Agregar al carrito
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="cuenta-btn cuenta-btn--borde pdet-info__carrito" disabled>Producto agotado</button>
                    }
                    <form asp-controller="Favorites" asp-action="Toggle" method="post" class="m-0">
                        <input type="hidden" name="type" value="Product" />
                        <input type="hidden" name="itemId" value="@Model.Id" />
                        <button type="submit" class="pdet-fav" title="Guardar en favoritos" aria-label="Guardar en favoritos">
                            <i class="fa-regular fa-heart" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>

                <div class="pdet-info__beneficios">
                    <span><i class="fa-solid fa-truck" aria-hidden="true"></i> Envíos a todo Bolivia</span>
                    <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Pagos seguros</span>
                    <span><i class="fa-solid fa-leaf" aria-hidden="true"></i> Equipo seleccionado</span>
                </div>

                <a asp-controller="Products" asp-action="Index" class="cuenta-volver">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Volver al catálogo
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Cambia la imagen principal al tocar una miniatura.
        function cambiarImagen(src, thumb) {
            document.getElementById('mainImage').src = src;
            document.querySelectorAll('.pdet-galeria__thumb').forEach(t => t.classList.remove('active'));
            if (thumb) thumb.classList.add('active');
        }

        // Botones − y + de la cantidad (entre 1 y el stock disponible).
        function cambiarCantidad(delta) {
            const input = document.getElementById('cantidad');
            const nuevo = (parseInt(input.value) || 1) + delta;
            if (nuevo >= 1 && nuevo <= parseInt(input.max)) input.value = nuevo;
        }
    </script>
}
