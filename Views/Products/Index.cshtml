@model EcommerceApp.Models.ProductosViewModel
@{
    ViewData["Title"] = "Productos - Equipamiento Outdoor";
    ViewData["FullBleed"] = true; // El hero ocupa todo el ancho, detrás del navbar transparente
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
}

@* Token CSRF para las llamadas AJAX de carrito/favoritos (ver wwwroot/js/productos.js) *@
@Html.AntiForgeryToken()

    <div class="productos-page">
        <!-- === HERO DE PRODUCTOS === -->
        <section class="productos-hero" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&h=900&fit=crop');">
            <div class="productos-hero__content">
                <h1 class="productos-hero__title">EQUÍPATE PARA EXPLORAR</h1>
                <p class="productos-hero__subtitle">El equipo adecuado convierte una ruta en una experiencia.</p>
                <p class="productos-hero__text">
                    Encuentra equipamiento pensado para acompañarte desde el primer sendero hasta las rutas más exigentes.
                </p>
                <a href="#catalogo" class="productos-hero__cta">EXPLORAR EQUIPAMIENTO</a>
            </div>
            
        </section>

       
        <!-- === CATEGORÍAS === -->
        <section class="productos-categories">
            <div class="productos-container">
                <div class="productos-categories__header">
                    <h2 class="productos-categories__title">ENCUENTRA TU EQUIPO</h2>
                    <p class="productos-categories__subtitle">Todo lo necesario para moverte por la montaña.</p>
                </div>

                <div class="productos-categories__grid">
                    @{
                        var categories = Model.AvailableCategories ?? new List<string>();
                        // Patrón cíclico de tamaños para el efecto "mosaico" (cuadrados y
                        // rectángulos de distinto tamaño), no depende del nombre de la categoría.
                        var mosaicSizes = new[] { "productos-category--big", "productos-category--small", "productos-category--wide", "productos-category--tall", "productos-category--small", "productos-category--wide" };
                        var i = 0;

                        foreach (var category in categories)
                        {
                            var imageSrc = ProductCategories.Images.ContainsKey(category)
                                ? ProductCategories.Images[category]
                                : ProductCategories.DefaultImage;

                            var sizeClass = mosaicSizes[i % mosaicSizes.Length];
                            i++;

                            <a asp-action="Index" asp-route-category="@category"
                               class="productos-category @sizeClass productos-animate"
                               style="background-image: url('@imageSrc');">
                                <img src="@imageSrc" alt="@category" class="productos-category__image" loading="lazy" />
                                <div class="productos-category__overlay">
                                    <h3 class="productos-category__name">@category</h3>
                                    <span class="productos-category__explore">EXPLORAR →</span>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        </section>

        <!-- === CATÁLOGO === -->
        <section class="productos-catalog" id="catalogo">
            <div class="productos-container">
                <div class="productos-catalog__header">
                    <h2 class="productos-catalog__title">EQUIPAMIENTO DESTACADO</h2>
                    <p class="productos-catalog__count">@(Model.TotalProducts) productos disponibles</p>
                </div>

                <div class="productos-catalog__container">
                    <!-- === FILTROS === -->
                    <aside class="productos-filters" id="filtros">
                        <h3 class="productos-filters__title">FILTRAR</h3>

                        <form method="get" asp-action="Index" id="filtros-form">
                            <div class="productos-filters__group">
                                <label class="productos-filters__label">Buscar</label>
                                <input type="text" name="search" class="productos-filters__search"
                                       placeholder="¿Qué buscas?" value="@Model.SearchTerm" />
                            </div>

                            <div class="productos-filters__group">
                                <label class="productos-filters__label">Ordenar por</label>
                                <select name="orderBy" class="productos-filters__select" onchange="document.getElementById('filtros-form').submit();">
                                    <option value="featured" selected="@(Model.OrderBy == "featured")">Destacados</option>
                                    <option value="newest" selected="@(Model.OrderBy == "newest")">Más recientes</option>
                                    <option value="price-asc" selected="@(Model.OrderBy == "price-asc")">Precio: Menor a Mayor</option>
                                    <option value="price-desc" selected="@(Model.OrderBy == "price-desc")">Precio: Mayor a Menor</option>
                                </select>
                            </div>

                            @if (Model.AvailableCategories?.Any() == true)
                            {
                                <div class="productos-filters__group">
                                    <label class="productos-filters__label">Categoría</label>
                                    <select name="category" class="productos-filters__select" onchange="document.getElementById('filtros-form').submit();">
                                        <option value="">Todas las categorías</option>
                                        @foreach (var cat in Model.AvailableCategories)
                                        {
                                            <option value="@cat" selected="@(Model.ActiveCategory == cat)">@cat</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="productos-filters__group">
                                <label class="productos-filters__label">Rango de precio</label>
                                <div class="productos-filters__range">
                                    <input type="number" name="minPrice" class="productos-filters__range-input"
                                           placeholder="Min" value="@Model.MinPrice" min="0" />
                                    <span style="color: var(--productos-text-secondary);">-</span>
                                    <input type="number" name="maxPrice" class="productos-filters__range-input"
                                           placeholder="Max" value="@Model.MaxPrice" min="0" />
                                </div>
                            </div>

                            @if (Model.AvailableBrands?.Any() == true)
                            {
                                <div class="productos-filters__group">
                                    <label class="productos-filters__label">Marca</label>
                                    <select name="brand" class="productos-filters__select" onchange="document.getElementById('filtros-form').submit();">
                                        <option value="">Todas las marcas</option>
                                        @foreach (var b in Model.AvailableBrands)
                                        {
                                            <option value="@b" selected="@(Model.SelectedBrand == b)">@b</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="productos-filters__group">
                                <label class="productos-filters__checkbox">
                                    <input type="checkbox" name="onlyOffers" value="true" checked="@Model.OnlyOffers"
                                           onchange="document.getElementById('filtros-form').submit();" />
                                    Solo ofertas
                                </label>
                            </div>

                            <button type="submit" class="productos-filters__btn">APLICAR FILTROS</button>
                            <a asp-action="Index" class="productos-filters__btn productos-filters__btn--secondary">LIMPIAR FILTROS</a>
                        </form>
                    </aside>

                    <!-- === CATÁLOGO === -->
                    <main>
                        <button class="productos-filters-toggle" id="filtros-toggle">☰ FILTRAR EQUIPAMIENTO</button>
                        <div class="productos-filters-overlay" id="filtros-overlay"></div>

                        <div class="productos-grid" id="productos-grid">
                            @if (Model.Products?.Any() == true)
                            {
                                @foreach (var product in Model.Products)
                                {
                                    <div class="productos-animate">
                                        @{
                                            var cardViewData = new ViewDataDictionary(ViewData)
                                            {
                                                ["IsFavorite"] = Model.FavoriteProductIds.Contains(product.Id)
                                            };
                                        }
                                        @await Html.PartialAsync("_ProductoCard", product, cardViewData)
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="productos-empty" style="grid-column: 1 / -1;">
                                    <div class="productos-empty__icon">🔍</div>
                                    <p class="productos-empty__text">No encontramos productos que coincidan con tu búsqueda.</p>
                                    <p class="productos-empty__text" style="font-size: 0.95rem;">Intenta cambiar los filtros o la búsqueda.</p>
                                </div>
                            }
                        </div>
                    </main>
                </div>
            </div>
        </section>
    </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filtrosToggle = document.getElementById('filtros-toggle');
            const filtros = document.getElementById('filtros');
            const overlay = document.getElementById('filtros-overlay');

            if (filtrosToggle) {
                filtrosToggle.addEventListener('click', function () {
                    filtros.classList.toggle('active');
                    overlay.classList.toggle('active');
                });

                overlay.addEventListener('click', function () {
                    filtros.classList.remove('active');
                    overlay.classList.remove('active');
                });
            }

            const links = filtros.querySelectorAll('a');
            links.forEach(link => {
                link.addEventListener('click', function () {
                    filtros.classList.remove('active');
                    overlay.classList.remove('active');
                });
            });
        });
    </script>
    <script src="~/js/productos.js" asp-append-version="true"></script>
}