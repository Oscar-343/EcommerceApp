@model EcommerceApp.Models.Product

<div class="card h-100">
    <img src="@(Model.ImageUrl ?? "/images/default-product.jpg")" class="card-img-top" alt="@Model.Name" style="height:200px; object-fit:cover;" />
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted small">@Model.Category</p>

        @if (Model.PromotionalPrice.HasValue && Model.PromotionalPrice < Model.Price)
        {
            <p class="card-text mb-0">
                <span class="text-muted text-decoration-line-through">@Model.Price.ToString("C")</span>
                <span class="text-danger fw-bold">@Model.PromotionalPrice.Value.ToString("C")</span>
                <span class="badge bg-danger">Oferta</span>
            </p>
        }
        else
        {
            <p class="card-text"><strong>@Model.Price.ToString("C")</strong></p>
        }

        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info mt-auto">Ver detalle</a>
    </div>
</div>