@model List<EcommerceApp.Models.Reservation>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis reservas";
}
<link rel="stylesheet" href="~/css/carrito.css" asp-append-version="true" />

<div class="container-fluid cart-page">
    <section class="cart-hero">
        <h1 class="cart-title">Mis reservas 🥾</h1>
        <p class="cart-sub">Historial de tus reservas de rutas.</p>
    </section>

    <div class="cart-section">
        @if (!Model.Any())
        {
            <div class="cart-empty-state">
                <h3 class="cart-empty-state__title">Todavía no tienes reservas</h3>
                <p>Elige una ruta y reserva tu fecha de salida.</p>
                <a asp-controller="Services" asp-action="Index" class="cart-btn-primary cart-empty-state__btn">Ver rutas</a>
            </div>
        }
        else
        {
            <div class="cart-list">
                @foreach (var r in Model)
                {
                    <div class="cart-item cart-item--row">
                        <div class="cart-item__info">
                            <h4 class="cart-item__name">@(r.Service?.Name ?? "Ruta eliminada")</h4>
                            <div class="cart-item__meta">
                                Salida: @r.TripDate.ToString("dd/MM/yyyy") &middot; @r.PeopleCount persona(s)
                            </div>
                        </div>
                        <div class="cart-item__side">
                            <div class="cart-item__price">@PriceFormatter.Format(r.TotalPrice)</div>
                            <div class="cart-item__meta">@r.Status</div>
                            @if (r.Status == "Pendiente")
                            {
                                <form asp-action="Cancel" asp-route-id="@r.Id" method="post" class="cart-item__cancel-form">
                                    <button type="submit" class="btn btn-sm btn-outline-danger cart-item__remove" onclick="return confirm('¿Cancelar esta reserva?')">Cancelar</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
