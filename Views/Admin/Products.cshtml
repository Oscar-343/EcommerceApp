@model List<EcommerceApp.Models.Product>
@{
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <div>
        <h1>Productos</h1>
        <p>@Model.Count producto(s) en el catálogo de la tienda.</p>
    </div>
    <a asp-action="ProductCreate" class="btn-admin btn-admin-primary">+ Nuevo producto</a>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h2>Catálogo</h2>
        <form method="get" asp-action="Products">
            <input type="text" name="q" value="@ViewBag.Query" class="admin-search" placeholder="Buscar por nombre o marca..." />
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 8l-8-5-8 5v8l8 5 8-5V8z"/><path d="M4 8l8 5 8-5"/></svg>
            <h3>Sin resultados</h3>
            <p>No hay productos que coincidan con la búsqueda. <a asp-action="ProductCreate" style="color:var(--sand);">Creá uno nuevo</a>.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Etiquetas</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="cell-thumb" alt="" onerror="this.style.visibility='hidden'" />
                                }
                                else
                                {
                                    <div class="cell-thumb"></div>
                                }
                            </td>
                            <td>
                                <strong>@product.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(product.Brand))
                                {
                                    <div class="cell-muted" style="font-size:0.76rem;">@product.Brand</div>
                                }
                            </td>
                            <td class="cell-muted">@(product.Category ?? "—")</td>
                            <td>
                                @if (product.PromotionalPrice.HasValue && product.PromotionalPrice < product.Price)
                                {
                                    <span class="cell-muted" style="text-decoration:line-through;">@product.Price.ToString("C")</span>
                                    <br /><span style="color:#f4897e; font-weight:700;">@product.PromotionalPrice.Value.ToString("C")</span>
                                }
                                else
                                {
                                    @product.Price.ToString("C")
                                }
                            </td>
                            <td>
                                @if (product.Stock <= 5)
                                {
                                    <span class="pill pill-red">@product.Stock</span>
                                }
                                else
                                {
                                    @product.Stock
                                }
                            </td>
                            <td>
                                @if (product.IsFeatured) { <span class="pill pill-sand">Destacado</span> }
                                @if (product.IsNew) { <span class="pill pill-blue">Nuevo</span> }
                                @if (product.IsBestSeller) { <span class="pill pill-green">Top ventas</span> }
                            </td>
                            <td>
                                <div class="row-actions">
                                    <a asp-action="ProductEdit" asp-route-id="@product.Id" class="btn-admin btn-admin-outline btn-admin-sm">Editar</a>
                                    <form asp-action="ProductDelete" asp-route-id="@product.Id" method="post"
                                          onsubmit="return confirm('¿Eliminar el producto \'@product.Name.Replace("'", "\\'")\'? Esta acción no se puede deshacer.');">
                                        <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
