@using EcommerceApp.Models.Reports
@model ReservationsReportViewModel
@{
    Layout = "_AdminLayout";
    string[] meses = { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    var estados = new[] { "Pendiente", "Recorrido", "Acabado", "Cancelado" };
    string PillClass(string status) => status switch
    {
        "Pendiente" => "pill-yellow",
        "Recorrido" => "pill-blue",
        "Acabado" => "pill-green",
        "Cancelado" => "pill-red",
        _ => "pill-gray"
    };
}

<div class="admin-page-header">
    <div>
        <h1>Reservas</h1>
        <p>Filtrado por fecha de salida (TripDate), estado y ruta.</p>
    </div>
    <div class="no-print admin-export-actions">
        <a class="btn-admin btn-admin-outline btn-admin-sm" asp-action="ReportReservationsCsv"
           asp-route-desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta.ToString("yyyy-MM-dd")"
           asp-route-estado="@Model.Estado" asp-route-serviceId="@Model.ServiceId">Exportar CSV</a>
        <button type="button" class="btn-admin btn-admin-outline btn-admin-sm" onclick="window.print()">Imprimir / Guardar como PDF</button>
    </div>
</div>

<div class="admin-card" style="margin-bottom:1.8rem;">
    <form method="get" asp-action="ReportReservations" style="display:flex; flex-wrap:wrap; gap:1rem; align-items:end; padding:1.2rem 1.4rem;">
        <div class="form-field">
            <label>Desde</label>
            <input type="date" name="desde" class="form-control" value="@Model.Desde.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-field">
            <label>Hasta</label>
            <input type="date" name="hasta" class="form-control" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-field">
            <label>Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                @foreach (var s in estados)
                {
                    <option value="@s" selected="@(Model.Estado == s)">@s</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label>Ruta</label>
            <select name="serviceId" class="form-select">
                <option value="">Todas</option>
                @foreach (var r in Model.Rutas)
                {
                    <option value="@r.Id" selected="@(Model.ServiceId == r.Id)">@r.Name</option>
                }
            </select>
        </div>
        <div class="form-field">
            <button type="submit" class="btn-admin btn-admin-primary">Filtrar</button>
        </div>
    </form>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-value">@Model.PorEstado.Sum(e => e.Count)</div>
        <div class="stat-card-label">Reservas en el filtro</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-value">@Model.TasaCancelacion.ToString("N1")%</div>
        <div class="stat-card-label">Tasa de cancelación</div>
    </div>
</div>

<div class="admin-card" style="margin-bottom:1.8rem;">
    <div class="admin-card-header">
        <h2>Por estado</h2>
    </div>
    @if (Model.PorEstado.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18"/></svg>
            <h3>No hay reservas</h3>
            <p>No se encontraron reservas con este filtro.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Estado</th>
                        <th>Cantidad</th>
                        <th>Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.PorEstado)
                    {
                        <tr>
                            <td><span class="pill @PillClass(e.Status)">@e.Status</span></td>
                            <td>@e.Count</td>
                            <td>@PriceFormatter.Format(e.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="admin-card" style="margin-bottom:1.8rem;">
    <div class="admin-card-header">
        <h2>Por ruta</h2>
    </div>
    @if (Model.PorRuta.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
            <h3>No hay rutas con reservas</h3>
            <p>No se encontraron reservas con este filtro.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ruta</th>
                        <th>Cantidad</th>
                        <th>Personas</th>
                        <th>Monto (Acabado)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.PorRuta)
                    {
                        <tr>
                            <td>@r.RouteName</td>
                            <td>@r.Count</td>
                            <td>@r.People</td>
                            <td>@PriceFormatter.Format(r.AmountAcabado)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h2>Por mes (fecha de salida)</h2>
    </div>
    @if (Model.PorMes.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18"/></svg>
            <h3>Sin datos</h3>
            <p>No se encontraron reservas con este filtro.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mes</th>
                        <th>Cantidad</th>
                        <th>Monto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.PorMes)
                    {
                        <tr>
                            <td>@meses[m.Month] @m.Year</td>
                            <td>@m.Count</td>
                            <td>@PriceFormatter.Format(m.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
