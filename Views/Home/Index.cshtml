@model EcommerceApp.Models.HomeViewModel
@{
    ViewData["Title"] = "Tren al Sur - Plataforma de Aventuras Outdoor";
    ViewData["FullBleed"] = true; // El hero ocupa toda la pantalla, detrás del navbar transparente
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #0B100E;
            color: #F1F3F1;
            font-family: 'Open Sans', sans-serif;
        }
    </style>
}

@* ============================================================
   HERO DE MARCA — Home v2
   El video queda "clavado" en pantalla (position: fixed en el CSS)
   mientras el resto del contenido pasa por encima, igual que el
   efecto de fondo fijo que ya usamos en Productos.
   ============================================================ *@
<section class="hero-brand">

    <div class="hero-brand__media">
        <video class="hero-brand__video" autoplay muted loop playsinline preload="metadata" disablepictureinpicture>
            <source src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/Video%20Project.mp4" type="video/mp4">
        </video>
        <div class="hero-brand__overlay"></div>

        <svg class="hero-brand__contours" viewBox="0 0 400 420" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M10 400C110 360 150 280 90 220C30 160 70 80 170 60" stroke="currentColor" stroke-width="1"/>
            <path d="M45 400C160 355 190 270 130 205C70 140 110 55 220 40" stroke="currentColor" stroke-width="1"/>
            <path d="M85 400C215 350 235 260 175 195C115 130 150 45 265 30" stroke="currentColor" stroke-width="1"/>
        </svg>
    </div>

    <div class="hero-brand__flourish" aria-hidden="true">
        <i class="fas fa-dove"></i>
        <span>NATURALEZA<br>AVENTURA<br>LIBERTAD</span>
    </div>

    <div class="hero-brand__scrollcue" aria-hidden="true">
        <span class="hero-brand__scrollcue-text">SCROLL</span>
        <span class="hero-brand__scrollcue-line"><span class="hero-brand__scrollcue-dot"></span></span>
    </div>

    <div class="hero-brand__content">
        <p class="hero-brand__kicker">
            <span class="hero-brand__kicker-line"></span>
            EQUIPAMIENTO · RUTAS · EXPERIENCIAS
        </p>

        <h1 class="hero-brand__title">
            <span class="hero-brand__title-line hero-brand__title-line--light">EXPLORA</span>
            <span class="hero-brand__title-line hero-brand__title-line--accent">BOLIVIA</span>
        </h1>

        <p class="hero-brand__subtitle">
            Descubre nuevos caminos, conecta con la naturaleza
            y prepárate para vivir grandes aventuras.
        </p>

        <div class="hero-brand__actions">
            <a asp-controller="Services" asp-action="Index" class="hero-brand__btn hero-brand__btn--primary">
                <i class="fas fa-compass"></i>
                <span>Explorar rutas</span>
                <i class="fas fa-arrow-right"></i>
            </a>
            <a asp-controller="Products" asp-action="Index" class="hero-brand__btn hero-brand__btn--outline">
                <i class="fas fa-backpack"></i>
                <span>Ver productos</span>
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<section class="hero-brand__stats">
    <div class="container-fluid">
        <div class="hero-brand__stats-grid">
            <div class="hero-brand__stat">
                <i class="fas fa-mountain"></i>
                <div>
                    <h3>Rutas reales</h3>
                    <p>Destinos seleccionados en Bolivia y más allá.</p>
                </div>
            </div>
            <div class="hero-brand__stat">
                <i class="fas fa-backpack"></i>
                <div>
                    <h3>Equipamiento de calidad</h3>
                    <p>Las mejores marcas para tus aventuras.</p>
                </div>
            </div>
            <div class="hero-brand__stat">
                <i class="fas fa-campground"></i>
                <div>
                    <h3>Experiencias únicas</h3>
                    <p>Senderismo, montañismo, camping y mucho más.</p>
                </div>
            </div>
            <div class="hero-brand__stat">
                <i class="fas fa-seedling"></i>
                <div>
                    <h3>Comunidad outdoor</h3>
                    <p>Personas que comparten la misma pasión.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- === CÓMO FUNCIONA === -->
<section class="section-how">
    <div class="container-fluid">
        <div class="how-grid">
            <a asp-controller="Services" asp-action="Index" class="how-step">
                <span class="how-step__number">01</span>
                <i class="fas fa-map-location-dot"></i>
                <h3>Elige tu ruta</h3>
                <p>Explorá rutas reales por dificultad, duración y región.</p>
            </a>
            <a asp-controller="Products" asp-action="Index" class="how-step">
                <span class="how-step__number">02</span>
                <i class="fas fa-backpack"></i>
                <h3>Equípate</h3>
                <p>Encontrá el equipo recomendado para esa aventura.</p>
            </a>
            <a asp-controller="Services" asp-action="Index" class="how-step">
                <span class="how-step__number">03</span>
                <i class="fas fa-person-hiking"></i>
                <h3>Vive la experiencia</h3>
                <p>Reservá y salí a caminar. Nosotros nos encargamos del resto.</p>
            </a>
        </div>
    </div>
</section>
    <!-- === DESCUBRE TU PRÓXIMO CAMINO === -->
    <section class="section-discover">
        <div class="container-fluid">
            <div class="section-header">
                <h2 class="section-title">DESCUBRE TU PRÓXIMO CAMINO</h2>
                <p class="section-subtitle">
                    Explora rutas, descubre nuevos paisajes y encuentra una aventura que quieras vivir.
                </p>
            </div>

            @{
                // Imágenes de relleno mientras no haya suficientes rutas reales cargadas.
                // Cuando agregues rutas con ImageUrl en la base, este carrusel las toma solas.
                var discoverPlaceholders = new[]
                {
                    "https://images.unsplash.com/photo-1519681393784-d120267933ba?w=800&h=1200&fit=crop",
                    "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800&h=1200&fit=crop",
                    "https://images.unsplash.com/photo-1470770841072-f978cf4d019e?w=800&h=1200&fit=crop",
                    "https://images.unsplash.com/photo-1454496522488-7a8e488e8606?w=800&h=1200&fit=crop"
                };
                var discoverSlots = Math.Max(Model.FeaturedRoutes.Count, 4);
            }

            <div class="discover-carousel">
                @for (int i = 0; i < discoverSlots; i++)
                {
                    var hasRoute = i < Model.FeaturedRoutes.Count;
                    var route = hasRoute ? Model.FeaturedRoutes[i] : null;
                    var imageUrl = (hasRoute && !string.IsNullOrEmpty(route!.ImageUrl))
                        ? route!.ImageUrl
                        : discoverPlaceholders[i % discoverPlaceholders.Length];
                    var name = hasRoute ? route!.Name : "PRÓXIMAMENTE";
                    var location = hasRoute ? (route!.Location ?? route!.Region ?? "Bolivia") : "Nueva ruta en camino";
                    var link = hasRoute
                        ? Url.Action("Details", "Services", new { id = route!.Id })
                        : Url.Action("Index", "Services");

                    <a class="discover-panel" href="@link">
                        <img src="@imageUrl" alt="@name" class="discover-panel__image" loading="lazy">
                        <div class="discover-panel__overlay"></div>
                        <span class="discover-panel__vertical-label">@name.ToUpper()</span>
                        <div class="discover-panel__caption">
                            <span class="discover-panel__location">@location</span>
                            <h3 class="discover-panel__name">@name</h3>
                            <span class="discover-panel__cta">@(hasRoute ? "DESCUBRIR RUTA →" : "VER TODAS LAS RUTAS →")</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
    <!-- === RUTAS EN EL MAPA (reutiliza initRutasMap() de rutas-map.js) === -->
    @{
        // La consulta ya filtra rutas sin coordenadas; aquí solo se arma el JSON del mapa.
        var homeMapRoutes = Model.RouteMarkers.Select(r => new
        {
            id = r.Id,
            name = r.Name,
            location = r.Location,
            difficulty = r.Difficulty != null && RouteDifficulty.Labels.ContainsKey(r.Difficulty)
                ? RouteDifficulty.Labels[r.Difficulty] : null,
            duration = r.DurationHours,
            lat = r.Latitude,
            lng = r.Longitude
        }).ToList();
    }
    @if (homeMapRoutes.Any())
    {
        <section class="rutas-map-section">
            <div class="container-fluid">
                <div class="section-header">
                    <h2 class="section-title">RUTAS CERCA DE TI</h2>
                    <p class="section-subtitle">Descubre en el mapa las rutas disponibles.</p>
                </div>
                <div id="rutasMap" class="rutas-map"
                     data-initial-view="bolivia"
                     data-routes='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(homeMapRoutes))'></div>
            </div>
        </section>
    }

    <!-- === EQUÍPATE PARA TU PRÓXIMA AVENTURA === -->
    <section class="section-equip-now">
        <div class="container-fluid">
            <div class="section-header">
                <h2 class="section-title">EQUÍPATE PARA TU PRÓXIMA AVENTURA</h2>
                <p class="section-subtitle">
                    Encuentra el equipamiento que necesitas para prepararte correctamente.
                </p>
            </div>

            <div class="products-curated">
                @if (Model.FeaturedProducts.Any())
                {
                    @foreach (var product in Model.FeaturedProducts.Take(4))
                    {
                        <!-- PRODUCTO CURADO: Imagen de producto real -->
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="product-curated-card">
                            <div class="product-image-wrapper">
                                <img src="@(product.ImageUrl ?? "/images/default-product.svg")"
                                     alt="@product.Name"
                                     class="product-curated-image"
                                     loading="lazy">
                                @if (product.IsNew)
                                {
                                    <span class="product-badge new">NUEVO</span>
                                }
                                @if (product.PromotionalPrice.HasValue && product.PromotionalPrice < product.Price)
                                {
                                    <span class="product-badge discount">OFERTA</span>
                                }
                            </div>
                            <div class="product-curated-info">
                                <p class="product-curated-category">@product.Category</p>
                                <h3 class="product-curated-name">@product.Name</h3>
                                @if (!string.IsNullOrEmpty(product.Brand))
                                {
                                    <p class="product-curated-brand">@product.Brand</p>
                                }
                                <div class="product-curated-price">
                                    @if (product.PromotionalPrice.HasValue && product.PromotionalPrice < product.Price)
                                    {
                                        <span class="price-original">@PriceFormatter.Format(product.Price)</span>
                                        <span class="price-current">@PriceFormatter.Format(product.PromotionalPrice)</span>
                                    }
                                    else
                                    {
                                        <span class="price-current">@PriceFormatter.Format(product.Price)</span>
                                    }
                                </div>
                            </div>
                        </a>
                    }
                }
            </div>

            <div class="section-cta">
                <a asp-controller="Products" asp-action="Index" class="btn-view-all">VER TODOS LOS PRODUCTOS</a>
            </div>
        </div>
    </section>

    <!-- === SECCIÓN EMOCIONAL === -->
    <section class="section-emotional-impact">
        <!-- IMAGEN EMOCIONAL: Persona caminando hacia montaña -->
        <div class="emotional-bg" style="background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&h=900&fit=crop');">
            <div class="emotional-overlay"></div>
            <div class="emotional-content">
                <h2 class="emotional-title">NO TODOS LOS CAMINOS APARECEN EN UN MAPA.</h2>
                <p class="emotional-subtitle">Algunos se encuentran caminando.</p>
            </div>
        </div>
    </section>

    <!-- === BARRA INFERIOR MÓVIL === -->
    <nav class="mobile-bottom-nav">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item active">
            <i class="fas fa-home"></i><span>Inicio</span>
        </a>
        <a asp-controller="Services" asp-action="Index" class="mobile-nav-item">
            <i class="fas fa-map-marked-alt"></i><span>Explorar</span>
        </a>
        <a asp-controller="Products" asp-action="Index" class="mobile-nav-item">
            <i class="fas fa-campground"></i><span>Productos</span>
        </a>
        <a asp-controller="Cart" asp-action="Index" class="mobile-nav-item">
            <i class="fas fa-shopping-cart"></i><span>Carrito</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="#profile" class="mobile-nav-item"><i class="fas fa-user"></i><span>Perfil</span></a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="mobile-nav-item"><i class="fas fa-user"></i><span>Perfil</span></a>
        }
    </nav>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/rutas-map.js" asp-append-version="true"></script>
}