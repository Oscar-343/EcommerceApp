@model List<EcommerceApp.Models.FavoriteItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis favoritos";
    var products = ViewBag.Products as List<EcommerceApp.Models.Product> ?? new();
    var services = ViewBag.Services as List<EcommerceApp.Models.Service> ?? new();
}
<link rel="stylesheet" href="~/css/favoritos.css" asp-append-version="true" />

<div class="container-fluid fav-page">
    <section class="fav-hero">
        <h1 class="fav-title">Mis favoritos</h1>
        <p class="fav-sub">Productos y rutas que guardaste para después.</p>
    </section>
    <div class="fav-grid">
        @if (!Model.Any())
        {
            <div class="fav-empty-state">
                <h3 class="fav-empty-state__title">Aún no tienes favoritos</h3>
                <p>Explora productos o rutas y haz clic en el corazón para guardarlos.</p>
                <a asp-controller="Products" asp-action="Index" class="cart-btn-primary fav-empty-state__btn">Ver tienda</a>
            </div>
        }
        else
        {
            @foreach (var fav in Model)
            {
                if (fav.Type == "Product")
                {
                    var p = products.FirstOrDefault(x => x.Id == fav.ItemId);
                    if (p != null)
                    {
                        <div class="fav-card">
                            <img src="@(p.ImageUrl ?? "/images/default-product.svg")" alt="" />
                            <h4>@p.Name</h4>
                            <div class="meta">@p.Category</div>
                            <div class="price">@PriceFormatter.Format(p.Price)</div>
                            <form asp-action="Toggle" method="post">
                                <input type="hidden" name="type" value="Product" />
                                <input type="hidden" name="itemId" value="@p.Id" />
                                <button type="submit" class="fav-btn-remove">Eliminar de favoritos</button>
                            </form>
                        </div>
                    }
                }
                else if (fav.Type == "Service")
                {
                    var s = services.FirstOrDefault(x => x.Id == fav.ItemId);
                    if (s != null)
                    {
                        <div class="fav-card">
                            <img src="@(s.ImageUrl ?? "/images/default-product.svg")" alt="" />
                            <h4>@s.Name</h4>
                            <div class="meta">@s.Category · @s.Region</div>
                            <div class="price">@PriceFormatter.Format(s.Price)</div>
                            <form asp-action="Toggle" method="post">
                                <input type="hidden" name="type" value="Service" />
                                <input type="hidden" name="itemId" value="@s.Id" />
                                <button type="submit" class="fav-btn-remove">Eliminar de favoritos</button>
                            </form>
                        </div>
                    }
                }
            }
        }
    </div>
</div>
