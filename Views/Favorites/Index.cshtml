@model List<EcommerceApp.Models.FavoriteItem>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis favoritos";
    var products = ViewBag.Products as List<EcommerceApp.Models.Product> ?? new();
    var services = ViewBag.Services as List<EcommerceApp.Models.Service> ?? new();

    // Respeta el orden en que se guardaron (más recientes primero) y omite los que ya no existen.
    var favProductos = Model.Where(f => f.Type == "Product").OrderByDescending(f => f.CreatedAt)
        .Select(f => products.FirstOrDefault(p => p.Id == f.ItemId)).Where(p => p != null).Select(p => p!).ToList();
    var favRutas = Model.Where(f => f.Type == "Service").OrderByDescending(f => f.CreatedAt)
        .Select(f => services.FirstOrDefault(s => s.Id == f.ItemId)).Where(s => s != null).Select(s => s!).ToList();
}
<link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />

<div class="cuenta-page">
    <section class="cuenta-hero" style="--hero-img: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1600&h=600&fit=crop');">
        <div class="cuenta-hero__inner">
            <i class="fa-solid fa-heart cuenta-hero__icon" aria-hidden="true"></i>
            <div>
                <p class="cuenta-hero__eyebrow">Guardado para después</p>
                <h1 class="cuenta-hero__title">Mis favoritos</h1>
                <p class="cuenta-hero__sub">El equipo y las rutas que te esperan para tu próxima salida.</p>
            </div>
        </div>
    </section>

    <div class="cuenta-wrap">
        <div class="cuenta-layout cuenta-layout--ancho">
            <div class="cuenta-main">
                @if (!favProductos.Any() && !favRutas.Any())
                {
                    <div class="cuenta-panel">
                        <div class="cuenta-vacio">
                            <div class="cuenta-vacio__icono"><i class="fa-regular fa-heart" aria-hidden="true"></i></div>
                            <div class="cuenta-vacio__titulo">Aún no tienes favoritos</div>
                            <p>Toca el corazón en un producto o una ruta para guardarlo aquí.</p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <a asp-controller="Products" asp-action="Index" class="cuenta-btn cuenta-btn--auto">Ver equipamiento</a>
                                <a asp-controller="Services" asp-action="Index" class="cuenta-btn cuenta-btn--auto cuenta-btn--borde">Ver rutas</a>
                            </div>
                        </div>
                    </div>
                }

                @* ---------- Equipamiento ---------- *@
                @if (favProductos.Any())
                {
                    <section class="cuenta-panel">
                        <div class="cuenta-panel__head">
                            <h2 class="cuenta-panel__title">
                                <i class="fa-solid fa-person-hiking" aria-hidden="true"></i>
                                Equipamiento (@favProductos.Count)
                            </h2>
                            <a asp-controller="Products" asp-action="Index" class="cuenta-link-sutil">
                                Ver tienda <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>

                        <div class="fav-grilla">
                            @foreach (var p in favProductos)
                            {
                                var enOferta = p.PromotionalPrice.HasValue && p.PromotionalPrice < p.Price;
                                <article class="fav-tarjeta">
                                    <div class="fav-tarjeta__media">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">
                                            <img src="@(p.ImageUrl ?? "/images/default-product.svg")" alt="@p.Name" loading="lazy" />
                                        </a>
                                        @if (p.Stock <= 0)
                                        {
                                            <span class="cuenta-tag cuenta-tag--error">Sin stock</span>
                                        }
                                        else if (enOferta)
                                        {
                                            <span class="cuenta-tag cuenta-tag--pendiente">Oferta</span>
                                        }
                                        <form asp-action="Toggle" method="post" class="fav-tarjeta__quitar">
                                            <input type="hidden" name="type" value="Product" />
                                            <input type="hidden" name="itemId" value="@p.Id" />
                                            <button type="submit" class="fav-tarjeta__corazon" aria-label="Quitar de favoritos" title="Quitar de favoritos">
                                                <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <div class="fav-tarjeta__body">
                                        <div class="fav-tarjeta__cat">@p.Category</div>
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="fav-tarjeta__nombre">@p.Name</a>
                                        <div class="fav-tarjeta__precio">
                                            @PriceFormatter.Format(p.PromotionalPrice ?? p.Price)
                                            @if (enOferta)
                                            {
                                                <s>@PriceFormatter.Format(p.Price)</s>
                                            }
                                        </div>
                                        <div class="fav-tarjeta__acciones">
                                            <form asp-controller="Cart" asp-action="Add" method="post">
                                                <input type="hidden" name="productId" value="@p.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="cuenta-btn cuenta-btn--sm" disabled="@(p.Stock <= 0)">
                                                    <i class="fa-solid fa-cart-plus" aria-hidden="true"></i> Agregar
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }

                @* ---------- Rutas ---------- *@
                @if (favRutas.Any())
                {
                    <section class="cuenta-panel">
                        <div class="cuenta-panel__head">
                            <h2 class="cuenta-panel__title">
                                <i class="fa-solid fa-route" aria-hidden="true"></i>
                                Rutas (@favRutas.Count)
                            </h2>
                            <a asp-controller="Services" asp-action="Index" class="cuenta-link-sutil">
                                Ver rutas <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>

                        <div class="fav-grilla">
                            @foreach (var s in favRutas)
                            {
                                <article class="fav-tarjeta">
                                    <div class="fav-tarjeta__media">
                                        <a asp-controller="Services" asp-action="Details" asp-route-id="@s.Id">
                                            <img src="@(s.ImageUrl ?? "/images/default-product.svg")" alt="@s.Name" loading="lazy" />
                                        </a>
                                        @if (!string.IsNullOrEmpty(s.Difficulty) && RouteDifficulty.Labels.TryGetValue(s.Difficulty, out var dificultad))
                                        {
                                            <span class="cuenta-tag">@dificultad</span>
                                        }
                                        <form asp-action="Toggle" method="post" class="fav-tarjeta__quitar">
                                            <input type="hidden" name="type" value="Service" />
                                            <input type="hidden" name="itemId" value="@s.Id" />
                                            <button type="submit" class="fav-tarjeta__corazon" aria-label="Quitar de favoritos" title="Quitar de favoritos">
                                                <i class="fa-solid fa-heart" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                    <div class="fav-tarjeta__body">
                                        <div class="fav-tarjeta__cat">@s.Category@(string.IsNullOrEmpty(s.Region) ? "" : " · " + s.Region)</div>
                                        <a asp-controller="Services" asp-action="Details" asp-route-id="@s.Id" class="fav-tarjeta__nombre">@s.Name</a>
                                        <div class="fav-tarjeta__precio">
                                            @PriceFormatter.Format(s.Price) <span class="fav-tarjeta__unidad">/ persona</span>
                                        </div>
                                        <div class="fav-tarjeta__acciones">
                                            <a asp-controller="Services" asp-action="Details" asp-route-id="@s.Id" class="cuenta-btn cuenta-btn--sm">
                                                Ver ruta <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>
