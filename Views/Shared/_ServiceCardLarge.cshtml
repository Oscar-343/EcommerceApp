@model EcommerceApp.Models.Service

@* Tarjeta grande de ruta/servicio: ocupa el ancho completo y destaca en la portada. *@
<div class="card shadow-sm border-0">
    <div class="row g-0">
        <div class="col-md-5">
            <img src="@(Model.ImageUrl ?? "/images/default-product.jpg")" class="img-fluid w-100 h-100" alt="@Model.Name" style="object-fit:cover; min-height:220px;" />
        </div>
        <div class="col-md-7">
            <div class="card-body">
                <h4 class="card-title mb-1">@Model.Name</h4>
                <p class="text-muted small mb-2">
                    @Model.Category
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span>· 📍 @Model.Location</span>
                    }
                </p>
                <p class="card-text">@Model.Description</p>

                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.Difficulty))
                    {
                        <span class="badge bg-secondary me-1">Dificultad: @Model.Difficulty</span>
                    }
                    @if (Model.DistanceKm.HasValue)
                    {
                        <span class="badge bg-secondary me-1">@Model.DistanceKm.Value.ToString("0.#") km</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Duration))
                    {
                        <span class="badge bg-secondary">Duración: @Model.Duration</span>
                    }
                </div>

                <p class="fs-5 fw-bold text-success mb-2">@Model.Price.ToString("C")</p>
                <a asp-controller="Services" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-success">Ver ruta</a>
            </div>
        </div>
    </div>
</div>