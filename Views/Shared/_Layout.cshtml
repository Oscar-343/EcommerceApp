<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcommerceApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-new.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tren-al-sur.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar-cinematic">
            <div class="nav-container">
                <a class="nav-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Logo" />
                    <span>Tren al Sur</span>
                </a>
                <ul class="nav-menu">
                    <li><a class="nav-link" asp-controller="Products" asp-action="Index">Tienda</a></li>
                    <li><a class="nav-link" asp-controller="Services" asp-action="Index">Servicios</a></li>
                    <li><a class="nav-link" asp-controller="Cart" asp-action="Index">Carrito 🏔</a></li>
                    <li><a class="nav-link" asp-controller="Favorites" asp-action="Index">Favoritos ❤️</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span>Hola, @User.Identity.Name</span>

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit">Cerrar sesión</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login">
            Iniciar sesión
        </a>
        <a asp-controller="Account" asp-action="Register">
            Registrarse
        </a>
    }   

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EcommerceApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
