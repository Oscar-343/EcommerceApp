@model EcommerceApp.Models.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Pedido #{Model.Id}";
}
<link rel="stylesheet" href="~/css/carrito.css" asp-append-version="true" />

<div class="container-fluid cart-page">
    <section class="cart-hero">
        <h1 class="cart-title">Pedido #@Model.Id</h1>
        <p class="cart-sub">Hecho el @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") &middot; Estado: @Model.Status</p>
    </section>

    <a asp-action="Index" class="cart-back">&larr; Volver a mis pedidos</a>

    <div class="cart-layout cart-layout--compact">
        <div class="cart-layout__main">
            <div class="cart-list">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-item cart-item--row">
                        <div class="cart-item__info">
                            <h4 class="cart-item__name">@item.ProductName</h4>
                            <div class="cart-item__meta">@item.ProductCategory</div>
                            <div class="cart-item__price">@PriceFormatter.Format(item.UnitPrice) c/u &middot; Cantidad: @item.Quantity &middot; Subtotal: @PriceFormatter.Format(item.UnitPrice * item.Quantity)</div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="cart-layout__aside">
            <div class="cart-summary">
                <h3 class="cart-summary__title">Resumen</h3>
                <div class="cart-summary__total cart-summary__line">
                    <span>Total</span>
                    <span>@PriceFormatter.Format(Model.Total)</span>
                </div>
                <div class="cart-summary__status">Estado: <strong>@Model.Status</strong></div>
                @if (Model.DeliveredAt.HasValue)
                {
                    <div class="cart-summary__date">Entregado el @Model.DeliveredAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                }
                @if (Model.Status == "Pendiente")
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="cart-summary__form">
                        <button type="submit" class="btn btn-outline-danger cart-summary__btn" onclick="return confirm('¿Cancelar este pedido?')">Cancelar pedido</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
