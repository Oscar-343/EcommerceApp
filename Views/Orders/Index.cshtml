@model List<EcommerceApp.Models.Order>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mis pedidos";
}
<link rel="stylesheet" href="~/css/carrito.css" asp-append-version="true" />

<div class="container-fluid cart-page">
    <section class="cart-hero">
        <h1 class="cart-title">Mis pedidos 📦</h1>
        <p class="cart-sub">Historial de tus pedidos confirmados.</p>
    </section>

    <div class="cart-section">
        @if (!Model.Any())
        {
            <div class="cart-empty-state">
                <h3 class="cart-empty-state__title">Todavía no tienes pedidos</h3>
                <p>Cuando confirmes tu carrito, aparecerán aquí.</p>
                <a asp-controller="Products" asp-action="Index" class="cart-btn-primary cart-empty-state__btn">Ver tienda</a>
            </div>
        }
        else
        {
            <div class="cart-list">
                @foreach (var order in Model)
                {
                    <a asp-action="Details" asp-route-id="@order.Id" class="cart-item cart-item--row cart-item--link">
                        <div class="cart-item__info">
                            <h4 class="cart-item__name">Pedido #@order.Id</h4>
                            <div class="cart-item__meta">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="cart-item__side">
                            <div class="cart-item__price">@PriceFormatter.Format(order.Total)</div>
                            <div class="cart-item__meta">@order.Status</div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
