@model EcommerceApp.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-page">

    <!-- ===================== FONDO ===================== -->
    <div class="auth-bg">
        <div class="auth-bg-image"></div>
    </div>

    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Tren al Sur" />
    </a>

    <div class="auth-card">
        <div class="auth-stack">
            <div class="auth-view">
                <form asp-action="ResetPassword" method="post" class="auth-form" novalidate>
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                    <h1 class="auth-title">Nueva contraseña</h1>
                    <p class="auth-subtitle">Elige una contraseña nueva para tu cuenta.</p>

                    <div class="auth-field">
                        <label asp-for="Password">Contraseña nueva</label>
                        <div class="auth-input-wrap">
                            <input asp-for="Password" id="ResetPassword" class="auth-input has-toggle" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="ResetPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                        <div class="auth-input-wrap">
                            <input asp-for="ConfirmPassword" id="ConfirmPassword" class="auth-input has-toggle" placeholder="Repite tu contraseña" autocomplete="new-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="ConfirmPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-error-text"></span>
                    </div>

                    <button type="submit" class="auth-submit">Restablecer contraseña</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}