@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="auth-page">

    <!-- ===================== FONDO ===================== -->
    <div class="auth-bg">
        <div class="auth-bg-image"></div>
    </div>
    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Tren al Sur" />
    </a>

    <div class="auth-card">
        <div class="auth-stack">
            <div class="auth-view">
                <div class="auth-form">
                    <h1 class="auth-title">¡Contraseña restablecida!</h1>
                    <p class="auth-subtitle">Ya puedes iniciar sesión con tu contraseña nueva.</p>
                    <div style="text-align:center;">
                        <a class="auth-submit" asp-action="Login" style="display:inline-block; text-decoration:none;">Iniciar sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>