@model EcommerceApp.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-page">

    <!-- ===================== FONDO ===================== -->
    <div class="auth-bg">
        <div class="auth-bg-image"></div>
    </div>
    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Tren al Sur" />
    </a>

    <div class="auth-card">
        <div class="auth-stack">
            <div class="auth-view">
                <form asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                    <h1 class="auth-title">¿Olvidaste tu contraseña?</h1>
                    <p class="auth-subtitle">Ingresá tu correo y te enviamos un enlace para restablecerla.</p>

                    <div class="auth-field">
                        <label asp-for="Email">Correo</label>
                        <input asp-for="Email" class="auth-input" placeholder="tucorreo@ejemplo.com" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="auth-error-text"></span>
                    </div>

                    <button type="submit" class="auth-submit">Enviar enlace</button>

                    <p class="auth-switch">
                        <a asp-action="Login">Volver a iniciar sesión</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}