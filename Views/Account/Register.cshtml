@model EcommerceApp.Models.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <div class="auth-bg">
        <div class="auth-bg-image"></div>

    </div>

    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Tren al Sur" />

    </a>

    <div class="auth-card">
        <div class="auth-stack">

            <!-- ===================== INICIAR SESIÓN (form real, oculto) ===================== -->
            <div class="auth-view is-hidden" data-view="signin">
                <form asp-action="Login" asp-controller="Account" method="post" class="auth-form" novalidate>
                    <h1 class="auth-title">Iniciar sesión</h1>
                    <p class="auth-subtitle">Tu próxima aventura comienza aquí.</p>

                    <div class="auth-field">
                        <label for="AltEmail">Correo</label>
                        <input type="email" name="Email" id="AltEmail" class="auth-input" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                    </div>

                    <div class="auth-field">
                        <label for="AltPassword">Contraseña</label>
                        <div class="auth-input-wrap">
                            <input type="password" name="Password" id="AltPassword" class="auth-input has-toggle" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="AltPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                    </div>

                    <div class="auth-row-between">
                        <label class="auth-check">
                            <input type="checkbox" name="RememberMe" /> Recordarme
                        </label>
                        <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="auth-submit">Iniciar sesión</button>

                    <p class="auth-switch">
                        ¿No tienes cuenta? <button type="button" data-auth-toggle="signup">Regístrate</button>
                    </p>
                </form>
            </div>

            <!-- ===================== CREAR CUENTA (activo) ===================== -->
            <div class="auth-view" data-view="signup">
                <form asp-action="Register" method="post" class="auth-form" novalidate>
                    <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                    <h1 class="auth-title">Crear cuenta</h1>
                    <p class="auth-subtitle">Regístrate para reservar experiencias y comprar tu equipo.</p>

                    <div class="auth-field">
                        <label asp-for="FullName">Nombre completo</label>
                        <input asp-for="FullName" class="auth-input" placeholder="Tu nombre" autocomplete="name" />
                        <span asp-validation-for="FullName" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Email">Correo</label>
                        <input asp-for="Email" class="auth-input" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">Contraseña</label>
                        <div class="auth-input-wrap">
                            <input asp-for="Password" id="RegPasswordMain" class="auth-input has-toggle" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="RegPasswordMain" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                        <div class="auth-input-wrap">
                            <input asp-for="ConfirmPassword" id="RegConfirmMain" class="auth-input has-toggle" placeholder="Repite tu contraseña" autocomplete="new-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="RegConfirmMain" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Address">Dirección (opcional)</label>
                        <input asp-for="Address" class="auth-input" placeholder="Ciudad, dirección" autocomplete="address-line1" />
                    </div>

                    <button type="submit" class="auth-submit">Crear cuenta</button>

                    <p class="auth-switch">
                        ¿Ya tienes cuenta? <button type="button" data-auth-toggle="signin">Inicia sesión</button>
                    </p>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
