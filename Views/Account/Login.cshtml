@model EcommerceApp.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">

    <!-- ===================== FONDO ===================== -->
    <div class="auth-bg">
        <div class="auth-bg-image"></div>
    </div>

    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <img src="https://viaymveoxuafmtqhfvri.supabase.co/storage/v1/object/public/product-image/logo.jpg" alt="Tren al Sur" />
    </a>

    <div class="auth-card">
        <div class="auth-stack">

            <!-- ===================== INICIAR SESIÓN (activo) ===================== -->
            <div class="auth-view" data-view="signin">
                <form asp-action="Login" method="post" class="auth-form" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="auth-alert"></div>

                    <h1 class="auth-title">Iniciar sesión</h1>
                    <p class="auth-subtitle">Tu próxima aventura comienza aquí.</p>

                    <div class="auth-field">
                        <label asp-for="Email">Correo</label>
                        <input asp-for="Email" class="auth-input" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="auth-error-text"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">Contraseña</label>
                        <div class="auth-input-wrap">
                            <input asp-for="Password" id="LoginPassword" class="auth-input has-toggle" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="LoginPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-error-text"></span>
                    </div>

                    <div class="auth-row-between">
                        <label class="auth-check">
                            <input asp-for="RememberMe" type="checkbox" /> Recordarme
                        </label>
                        <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="auth-submit">Iniciar sesión</button>
                </form>

                <div class="auth-divider">o continúa con</div>
                    <div class="auth-social-row">
                        <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                            <input type="hidden" name="provider" value="Google" />
                            <button type="submit" class="auth-social-btn">
                                <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                                Google
                            </button>
                        </form>
                        <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                            <input type="hidden" name="provider" value="GitHub" />
                            <button type="submit" class="auth-social-btn">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                                GitHub
                            </button>
                        </form>
                    </div>

                    <p class="auth-switch">
                        ¿No tienes cuenta? <button type="button" data-auth-toggle="signup">Regístrate</button>
                    </p>
            </div>

            <!-- ===================== CREAR CUENTA (form real, oculto) ===================== -->
            <div class="auth-view is-hidden" data-view="signup">
                <form asp-action="Register" asp-controller="Account" method="post" class="auth-form" novalidate>
                    <h1 class="auth-title">Crear cuenta</h1>
                    <p class="auth-subtitle">Regístrate para reservar experiencias y comprar tu equipo.</p>

                    <div class="auth-field">
                        <label for="RegFullName">Nombre completo</label>
                        <input type="text" name="FullName" id="RegFullName" class="auth-input" placeholder="Tu nombre" autocomplete="name" />
                    </div>

                    <div class="auth-field">
                        <label for="RegEmail">Correo</label>
                        <input type="email" name="Email" id="RegEmail" class="auth-input" placeholder="tucorreo@ejemplo.com" autocomplete="email" />
                    </div>

                    <div class="auth-field">
                        <label for="RegPassword">Contraseña</label>
                        <div class="auth-input-wrap">
                            <input type="password" name="Password" id="RegPassword" class="auth-input has-toggle" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                            <button type="button" class="auth-toggle-visibility" data-target="RegPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" /><circle cx="12" cy="12" r="3" /></svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit">Crear cuenta</button>
                </form>

                <div class="auth-divider">o regístrate con</div>
                    <div class="auth-social-row">
                        <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                            <input type="hidden" name="provider" value="Google" />
                            <button type="submit" class="auth-social-btn">
                                <svg width="16" height="16" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                                Google
                            </button>
                        </form>
                        <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                            <input type="hidden" name="provider" value="GitHub" />
                            <button type="submit" class="auth-social-btn">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                                GitHub
                            </button>
                        </form>
                    </div>

                    <p class="auth-switch">
                        ¿Ya tienes cuenta? <button type="button" data-auth-toggle="signin">Inicia sesión</button>
                    </p>
            </div>

        </div>
    </div>

    <div class="auth-demo-hint">
        <span class="auth-demo-hint-title">Acceso demo</span>
        <span class="auth-demo-hint-row"><strong>Usuario:</strong> juan@gmail.com</span>
        <span class="auth-demo-hint-row"><strong>Contraseña:</strong> Juan_123</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
